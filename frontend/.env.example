# Frontend configuration. Copy to .env.local for local development.
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time:
# never put secrets in them.

# Public URL of the Django API, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public URL of this website (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name of the website.
NEXT_PUBLIC_SITE_NAME=Maasil Matrimony

# Countries (ISO codes, comma-separated) offered in the mobile-number country picker for
# registration and SMS login. Keep in step with the API's SMS_ALLOWED_COUNTRY_CODES
# (calling codes): IN <-> 91, AE <-> 971, ... Only list countries your SMS provider delivers to.
NEXT_PUBLIC_SMS_COUNTRIES=IN

# Optional, server-side only: API URL reachable from the Next.js server
# (e.g. http://backend:8000/api/v1 inside Docker). Defaults to the public URL.
# API_INTERNAL_BASE_URL=

# Member dashboard UI preview: no login, fictional sample data, nothing sent to the API.
# While true, registration and sign-in don't reach the backend ("Design
# preview: … nothing was saved"). For UI development and client reviews only; NEVER true
# on the live site. Prefer `npm run preview:build` / `npm run preview:start` over setting it here.
# NEXT_PUBLIC_DASHBOARD_PREVIEW=false

# Fictional demo profiles in "Highlighted Profiles" show in development only.
# Set to true to show them in a production build (e.g. a staging demo); never on the live site.
# NEXT_PUBLIC_SHOW_DEMO_PROFILES=false

# Fictional demo stories in "Success Stories" show in development only.
# Set to true to show them in a production build (e.g. a staging demo); never on the live site.
# NEXT_PUBLIC_SHOW_DEMO_STORIES=false
