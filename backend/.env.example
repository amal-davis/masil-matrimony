# ---------------------------------------------------------------------------
# Backend environment configuration.
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Values marked REQUIRED have no default and the app will refuse to start
# without them.
# ---------------------------------------------------------------------------

# Settings module: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value

# Development only; production always forces DEBUG off.
DJANGO_DEBUG=True

# Comma-separated host names this API serves. Production must list real hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Path for the Django admin site. Use an unguessable value in production.
DJANGO_ADMIN_URL=admin/
# Badge shown in the admin header: Development | Staging | Production.
ADMIN_ENVIRONMENT_NAME=Development

DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# --- MySQL (REQUIRED: DB_NAME, DB_USER, DB_PASSWORD) ------------------------
DB_NAME=massil_matrimony
DB_USER=massil_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
# 3306 for a normal MySQL 8 / MariaDB 10.5+ install. XAMPP's MariaDB 10.4 is too old for
# Django 5.2: run a newer MariaDB on another port (e.g. 3308) and set it here (README step 6).
DB_PORT=3306
# Seconds to keep DB connections open (0 = close after each request).
DB_CONN_MAX_AGE=60
# Only used by docker-compose.yml to initialise the MySQL container.
MYSQL_ROOT_PASSWORD=change-me-root

# --- CORS / CSRF -----------------------------------------------------------
# Exact frontend origins, comma-separated. No wildcards. Production: https:// only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- API -------------------------------------------------------------------
# Swagger UI at /api/v1/docs/ (defaults: on in development, off in production)
API_DOCS_ENABLED=True
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=300/min
API_THROTTLE_AUTH=10/min
# Contact form submissions per visitor IP address.
API_THROTTLE_ENQUIRIES=5/hour

# --- JWT (mobile apps and server-side web session) -------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Production only -------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_TRUST_X_FORWARDED_PROTO=True   # only behind a trusted TLS proxy
# DJANGO_COOKIE_DOMAIN=.example.com

# --- SMS verification codes (registration and member login) -----------------
# Members register and log in with a one-time code sent by SMS; there is no
# member password and no email verification. Codes are generated and checked by
# this API (only a keyed hash is stored); the provider only delivers them.
#
# SMS_PROVIDER: msg91 | console (development only: codes go to the server log)
# Empty = not configured: registration and login answer "not available" (503).
# Production refuses to start with console. Development defaults to console.
SMS_PROVIDER=console
SMS_TIMEOUT_SECONDS=10
# MSG91 (https://msg91.com), Flow API. Never commit real values.
#   MSG91_AUTH_KEY:        auth key from the MSG91 panel (keep it secret).
#   MSG91_OTP_TEMPLATE_ID: id of an SMS template (SMS > Templates) whose text is
#                          DLT-approved for your registered sender ID (India), e.g.
#                          "##otp## is your Massil Matrimony verification code. It expires in 5 minutes."
#   MSG91_OTP_VARIABLE:    the template's variable name (##otp## -> otp).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VARIABLE=otp
# Country calling codes (comma-separated, no +) whose mobiles may register and log in.
# Only list countries MSG91 delivers to for you; keep the website's
# NEXT_PUBLIC_SMS_COUNTRIES (ISO codes, e.g. IN,AE) in step.
SMS_ALLOWED_COUNTRY_CODES=91

OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
# Codes per mobile number (registration and login together), and wrong guesses per code.
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_DAY=10
OTP_MAX_VERIFY_ATTEMPTS=5
# How long a registration can be resent / its number corrected without refilling the form.
OTP_REGISTRATION_WINDOW_SECONDS=3600
# Per visitor IP address: login code requests, registration starts/resends, code checks.
API_THROTTLE_OTP_REQUEST=10/hour
API_THROTTLE_REGISTER=10/hour
API_THROTTLE_OTP_VERIFY=20/hour

# --- Membership payments (Razorpay) ------------------------------------------
# Razorpay Dashboard > Account & Settings > API Keys. Test keys start rzp_test_, live keys
# rzp_live_; RAZORPAY_MODE must match. Development refuses live mode. Production refuses
# live mode unless the webhook secret, BILLING_SELLER_NAME/ADDRESS and SMTP email are set.
# Put real values ONLY in backend/.env (git-ignored). The key secret and webhook secret
# must never go in the frontend or in any NEXT_PUBLIC_ variable.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: the secret you type when creating the webhook for
# https://<your API host>/api/v1/payments/razorpay/webhook/ (not the API key secret).
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=15
API_THROTTLE_PAYMENTS=30/hour

# GST percent for packages priced "plus applicable GST" (Silver, Gold, Diamond, Platinum).
# Leave EMPTY until your accountant confirms it: those packages can't be bought online
# until then. Royal states its own 18% and doesn't use this.
MEMBERSHIP_GST_RATE_PERCENT=

# Seller details printed on payment receipts. Leave empty until confirmed; never invent them.
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_GSTIN=
BILLING_CONTACT_EMAIL=
BILLING_CONTACT_PHONE=
RECEIPT_NUMBER_PREFIX=MM
# Automatic retries of a failed receipt email (python manage.py retry_receipt_emails).
RECEIPT_EMAIL_MAX_ATTEMPTS=5
# A member changing their own email address, per member.
API_THROTTLE_EMAIL_UPDATE=10/hour

# --- Outgoing email (payment receipts; not used for sign-in) ------------------
# EMAIL_PROVIDER: smtp | console (development only: emails are printed by the API server)
# Empty = not configured: nothing is emailed. Production refuses console.
EMAIL_PROVIDER=console
# SMTP server or transactional email service (e.g. Amazon SES, Brevo, Zoho Mail).
# Use port 587 with EMAIL_USE_TLS=True, or 465 with EMAIL_USE_SSL=True (not both).
#
# Gmail for local testing: EMAIL_PROVIDER=smtp, EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_USE_TLS=True, EMAIL_HOST_USER=<your Gmail address>, EMAIL_HOST_PASSWORD=<a Google
# App Password (needs 2-Step Verification), never your normal password>, and
# DEFAULT_FROM_EMAIL=Massil Matrimony <your Gmail address>. Put the real values only in
# backend/.env, which Git ignores.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT_SECONDS=10
# Sender shown to members, on a domain whose SPF/DKIM records allow the SMTP service.
DEFAULT_FROM_EMAIL=Massil Matrimony <noreply@example.com>
# Public website address used in emailed links. Production: https:// required.
FRONTEND_URL=http://localhost:3000

# --- Member photos -----------------------------------------------------------
# Stored under DJANGO_MEDIA_ROOT (default backend/media), never served publicly:
# clients get signed URLs that expire after PHOTO_URL_TTL_SECONDS.
# DJANGO_MEDIA_ROOT=/var/lib/matrimony/media
PROFILE_PHOTO_MAX_BYTES=8388608
PROFILE_MAX_PHOTOS=10
PHOTO_URL_TTL_SECONDS=3600
# Public base URL of this API, used in photo URLs when requests reach Django
# through an internal address (e.g. https://api.example.com). Empty = request host.
API_PUBLIC_URL=
# Per member.
API_THROTTLE_PHOTO_UPLOAD=30/hour
API_THROTTLE_INTEREST_SEND=100/day
API_THROTTLE_CONTACT_VIEW=60/hour

# --- Integrations (added when implemented; secrets go here, never in code) -
# PAYMENT_GATEWAY=
# PAYMENT_GATEWAY_KEY_ID=
# PAYMENT_GATEWAY_KEY_SECRET=
